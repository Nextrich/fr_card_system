# Ты умничка! #дружба #поддержка #котик #анимация #мем
---
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np
from matplotlib.backends.backend_agg import FigureCanvasAgg
from PyQt6.QtGui import QImage, QPixmap

fps = 30
duration = 2.0

def _pixmap_from_fig(fig):
    canvas = FigureCanvasAgg(fig)
    canvas.draw()
    buf = canvas.buffer_rgba()
    w, h = canvas.get_width_height()
    img = QImage(buf, w, h, QImage.Format.Format_RGBA8888)
    px = QPixmap.fromImage(img).copy()
    plt.close(fig)
    return px

def build_frame(t):
    fig = plt.figure(figsize=(6, 4), dpi=100, facecolor="#fff0f5")
    ax = fig.add_subplot(111)
    ax.set_xlim(-10, 10)
    ax.set_ylim(-8, 8)
    ax.set_aspect("equal")
    ax.axis("off")

    # Прыжок котика: 0..1..0
    jump = abs(np.sin(t / duration * 2 * np.pi))
    cy = -1.0 + jump * 1.8

    # Тень на «земле» — уменьшается, когда прыгает
    ax.add_patch(patches.Ellipse((0, -3.2), 5 - jump * 1.5, 0.4,
                 color="#d0c4cc", alpha=0.5))

    # Морда кота
    face = patches.Ellipse((0, cy), 5.5, 4.5, color="#fdf6e3",
                            ec="#c98b5f", lw=2, zorder=2)
    ax.add_patch(face)

    # Ушки
    ax.add_patch(patches.Polygon([(-2.0, cy+1.8), (-1.4, cy+3.2), (-0.6, cy+2.2)],
                 closed=True, color="#fdf6e3", ec="#c98b5f", lw=2, zorder=2))
    ax.add_patch(patches.Polygon([(2.0, cy+1.8), (1.4, cy+3.2), (0.6, cy+2.2)],
                 closed=True, color="#fdf6e3", ec="#c98b5f", lw=2, zorder=2))

    # Глаза: подмигивает в такт прыжка
    blink = (jump > 0.85)
    if blink:
        ax.plot([-1.3, -0.7], [cy+0.5]*2, color="#333", lw=2.5, zorder=4)
        ax.plot([0.7, 1.3], [cy+0.5]*2, color="#333", lw=2.5, zorder=4)
    else:
        ax.add_patch(patches.Circle((-1.0, cy+0.5), 0.28, color="#333", zorder=4))
        ax.add_patch(patches.Circle((1.0, cy+0.5), 0.28, color="#333", zorder=4))
        ax.add_patch(patches.Circle((-0.9, cy+0.65), 0.1, color="white", zorder=5))
        ax.add_patch(patches.Circle((1.1, cy+0.65), 0.1, color="white", zorder=5))

    # Носик и ротик
    ax.add_patch(patches.Polygon([(-0.15, cy+0.1), (0.15, cy+0.1), (0, cy-0.05)],
                 closed=True, color="#e07a5f", zorder=4))
    ax.plot([-0.6, 0, 0.6], [cy-0.35, cy-0.15, cy-0.35],
            color="#e07a5f", lw=2, zorder=4)

    # Румянец
    ax.add_patch(patches.Ellipse((-1.8, cy-0.3), 0.9, 0.5,
                 color="#ffb3ba", alpha=0.8, zorder=3))
    ax.add_patch(patches.Ellipse((1.8, cy-0.3), 0.9, 0.5,
                 color="#ffb3ba", alpha=0.8, zorder=3))

    # Большой палец — правая лапка поднимается и качается
    thumb_angle = np.sin(t / duration * 2 * np.pi * 2) * 12
    ax.add_patch(patches.Ellipse((3.3, cy+1.0), 1.2, 1.8, angle=thumb_angle,
                 color="#fdf6e3", ec="#c98b5f", lw=2, zorder=3))
    ax.add_patch(patches.Ellipse((3.3, cy+2.0), 0.7, 0.9, angle=thumb_angle,
                 color="#fdf6e3", ec="#c98b5f", lw=2, zorder=3))

    # Искры вокруг во время приземления
    if jump < 0.3:
        for i in range(6):
            a = i * np.pi / 3 + t * 2
            r = 4.5
            ax.scatter([r*np.cos(a)], [cy + r*np.sin(a)],
                       s=120, color="#ffd700", marker="*", zorder=6)

    ax.text(0, 6.5, "ты умничка!", ha="center",
            fontsize=26, color="#c9184a", fontweight="bold",
            family="Comic Sans MS")
    ax.text(0, -6.8, "и вообще, ты справляешься лучше всех",
            ha="center", fontsize=11, color="#666", style="italic")

    plt.tight_layout()
    return _pixmap_from_fig(fig)