# Вся в меня )) #солнце
---
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import numpy as np
from matplotlib.backends.backend_agg import FigureCanvasAgg
from PyQt6.QtGui import QImage, QPixmap

fps = 30
duration = 2.5

def _pixmap_from_fig(fig):
    canvas = FigureCanvasAgg(fig)
    canvas.draw()
    buf = canvas.buffer_rgba()
    w, h = canvas.get_width_height()
    img = QImage(buf, w, h, QImage.Format.Format_RGBA8888)
    px = QPixmap.fromImage(img).copy()
    plt.close(fig)
    return px

def _draw_kitten(ax, cx, cy, scale, fur_color, alpha=1.0, blink=False):
    """
    Рисует котёнка-сидящего.
    cx, cy — центр мордочки.
    scale — масштаб (1.0 = базовый).
    fur_color — цвет шёрстки.
    alpha — общая прозрачность (для «проявления» копии).
    blink — если True, глазки закрыты (для анимации моргания).
    """
    s = scale

    # Тень под котёнком
    ax.add_patch(patches.Ellipse(
        (cx, cy - 2.4 * s), 2.6 * s, 0.4 * s,
        color="#000000", alpha=0.15 * alpha, zorder=1
    ))

    # Тельце (сидя)
    body = patches.Ellipse(
        (cx, cy - 1.3 * s), 2.4 * s, 2.2 * s,
        color=fur_color, ec="#7a5230", lw=1.8 * s, alpha=alpha, zorder=2
    )
    ax.add_patch(body)

    # Лапки передние — два маленьких овала
    ax.add_patch(patches.Ellipse(
        (cx - 0.55 * s, cy - 2.1 * s), 0.5 * s, 0.35 * s,
        color="#fff2e0", ec="#7a5230", lw=1.2 * s, alpha=alpha, zorder=3
    ))
    ax.add_patch(patches.Ellipse(
        (cx + 0.55 * s, cy - 2.1 * s), 0.5 * s, 0.35 * s,
        color="#fff2e0", ec="#7a5230", lw=1.2 * s, alpha=alpha, zorder=3
    ))

    # Хвостик — дуга справа
    tail_theta = np.linspace(-np.pi * 0.2, np.pi * 0.9, 30)
    tail_x = cx + 1.1 * s + 0.9 * s * np.cos(tail_theta)
    tail_y = cy - 1.6 * s + 0.9 * s * np.sin(tail_theta)
    ax.plot(tail_x, tail_y, color=fur_color, lw=6 * s,
            alpha=alpha, solid_capstyle="round", zorder=2)

    # Ушки
    ax.add_patch(patches.Polygon(
        [(cx - 1.05 * s, cy + 1.2 * s),
         (cx - 0.75 * s, cy + 2.4 * s),
         (cx - 0.15 * s, cy + 1.55 * s)],
        closed=True, color=fur_color, ec="#7a5230",
        lw=1.5 * s, alpha=alpha, zorder=4
    ))
    ax.add_patch(patches.Polygon(
        [(cx + 1.05 * s, cy + 1.2 * s),
         (cx + 0.75 * s, cy + 2.4 * s),
         (cx + 0.15 * s, cy + 1.55 * s)],
        closed=True, color=fur_color, ec="#7a5230",
        lw=1.5 * s, alpha=alpha, zorder=4
    ))
    # Внутренняя часть ушек — розовая
    ax.add_patch(patches.Polygon(
        [(cx - 0.85 * s, cy + 1.35 * s),
         (cx - 0.7 * s, cy + 2.05 * s),
         (cx - 0.35 * s, cy + 1.55 * s)],
        closed=True, color="#ffc4d6", alpha=alpha, zorder=5
    ))
    ax.add_patch(patches.Polygon(
        [(cx + 0.85 * s, cy + 1.35 * s),
         (cx + 0.7 * s, cy + 2.05 * s),
         (cx + 0.35 * s, cy + 1.55 * s)],
        closed=True, color="#ffc4d6", alpha=alpha, zorder=5
    ))

    # Голова (мордочка)
    ax.add_patch(patches.Ellipse(
        (cx, cy), 2.0 * s, 1.7 * s,
        color=fur_color, ec="#7a5230", lw=1.8 * s, alpha=alpha, zorder=5
    ))

    # Полоски на лбу (для «полосатого» вида) — тонкие
    for dx in (-0.25, 0, 0.25):
        ax.plot([cx + dx * s, cx + dx * s * 0.8],
                [cy + 0.65 * s, cy + 0.95 * s],
                color="#7a5230", lw=1.2 * s, alpha=alpha * 0.7, zorder=6)

    # Глазки
    if blink:
        # Закрытые — дуги
        ax.plot([cx - 0.6 * s, cx - 0.35 * s, cx - 0.1 * s],
                [cy + 0.1 * s, cy - 0.05 * s, cy + 0.1 * s],
                color="#333", lw=2 * s, alpha=alpha, zorder=7)
        ax.plot([cx + 0.1 * s, cx + 0.35 * s, cx + 0.6 * s],
                [cy + 0.1 * s, cy - 0.05 * s, cy + 0.1 * s],
                color="#333", lw=2 * s, alpha=alpha, zorder=7)
    else:
        # Открытые — большие круглые с бликом
        ax.add_patch(patches.Circle(
            (cx - 0.35 * s, cy + 0.05 * s), 0.24 * s,
            color="#333", alpha=alpha, zorder=7
        ))
        ax.add_patch(patches.Circle(
            (cx + 0.35 * s, cy + 0.05 * s), 0.24 * s,
            color="#333", alpha=alpha, zorder=7
        ))
        # Блики
        ax.add_patch(patches.Circle(
            (cx - 0.28 * s, cy + 0.13 * s), 0.08 * s,
            color="white", alpha=alpha, zorder=8
        ))
        ax.add_patch(patches.Circle(
            (cx + 0.42 * s, cy + 0.13 * s), 0.08 * s,
            color="white", alpha=alpha, zorder=8
        ))

    # Носик — маленький треугольник
    ax.add_patch(patches.Polygon(
        [(cx - 0.08 * s, cy - 0.35 * s),
         (cx + 0.08 * s, cy - 0.35 * s),
         (cx, cy - 0.5 * s)],
        closed=True, color="#e07a5f", alpha=alpha, zorder=7
    ))

    # Ротик — «w»-образный
    ax.plot([cx - 0.15 * s, cx - 0.08 * s, cx],
            [cy - 0.5 * s, cy - 0.62 * s, cy - 0.5 * s],
            color="#7a3a2c", lw=1.3 * s, alpha=alpha, zorder=7)
    ax.plot([cx, cx + 0.08 * s, cx + 0.15 * s],
            [cy - 0.5 * s, cy - 0.62 * s, cy - 0.5 * s],
            color="#7a3a2c", lw=1.3 * s, alpha=alpha, zorder=7)

    # Румянец
    ax.add_patch(patches.Ellipse(
        (cx - 0.75 * s, cy - 0.3 * s), 0.4 * s, 0.22 * s,
        color="#ffb3ba", alpha=alpha * 0.85, zorder=6
    ))
    ax.add_patch(patches.Ellipse(
        (cx + 0.75 * s, cy - 0.3 * s), 0.4 * s, 0.22 * s,
        color="#ffb3ba", alpha=alpha * 0.85, zorder=6
    ))

    # Усики
    for side, sign in [(-1, -1), (1, 1)]:
        for dy in (-0.15, 0, 0.15):
            ax.plot(
                [cx + sign * 0.5 * s, cx + sign * 0.95 * s],
                [cy + dy * s, cy + dy * s * 1.4],
                color="#7a5230", lw=0.9 * s,
                alpha=alpha * 0.7, zorder=6
            )

def build_frame(t):
    fig = plt.figure(figsize=(6, 4), dpi=100, facecolor="#e0fbfc")
    ax = fig.add_subplot(111)
    ax.set_xlim(-10, 10)
    ax.set_ylim(-8, 8)
    ax.set_aspect("equal")
    ax.axis("off")

    # Прогресс копирования: 0 → 1 → 0 за цикл
    progress = abs(np.sin(t / duration * np.pi))

    # Оригинал слева — слегка покачивается
    orig_x = -4 + 0.15 * np.sin(t * 3)
    orig_y = -0.5 + 0.1 * np.sin(t * 2.3)

    # Моргание: 6 раз в секунду, короткий импульс
    blink_phase = (t * 1.5) % 1.0
    blink = blink_phase < 0.08

    _draw_kitten(ax, orig_x, orig_y, 1.0, "#f7b267", alpha=1.0, blink=blink)

    # Копия справа — появляется с прозрачностью по progress
    copy_x = 4 + 0.15 * np.sin(t * 3 + 0.5)
    copy_y = -0.5 + 0.1 * np.sin(t * 2.3 + 0.5)

    # Масштаб копии чуть растёт по мере «проявления»
    copy_scale = 0.55 + 0.45 * progress
    # Копия мигает в противофазе
    copy_blink = ((t * 1.5 + 0.5) % 1.0) < 0.08

    _draw_kitten(ax, copy_x, copy_y, copy_scale, "#f7b267",
                 alpha=progress, blink=copy_blink)

    # Стрелки-«копирование» между ними
    if 0.15 < progress < 0.9:
        for k in range(3):
            arrow_alpha = progress * (1 - abs(k - 1) * 0.3)
            ay = -1.5 + k * 1.3 + 0.3 * np.sin(t * 4 + k)
            ax.annotate(
                "",
                xy=(2.2, ay), xytext=(orig_x + 1.8, ay),
                arrowprops=dict(
                    arrowstyle="->", color="#0077b6",
                    lw=2, alpha=arrow_alpha,
                    connectionstyle="arc3,rad=0.1"
                ),
                zorder=8
            )

    # Сердечки над обоими — пульсируют
    heart_scale = 0.10 + 0.02 * np.sin(t * 4)
    ang = np.linspace(0, 2 * np.pi, 100)
    base_x = 16 * np.sin(ang) ** 3 * heart_scale
    base_y = (13 * np.cos(ang) - 5 * np.cos(2 * ang)
              - 2 * np.cos(3 * ang) - np.cos(4 * ang)) * heart_scale

    # Над оригиналом
    ax.fill(base_x + orig_x, base_y + orig_y + 2.6,
            color="#ff4d6d", alpha=1.0, zorder=6)

    # Над копией — появляется вместе с ней
    if progress > 0.15:
        ax.fill(base_x + copy_x, base_y + copy_y + 2.3 * copy_scale + 0.8,
                color="#ff4d6d", alpha=progress, zorder=6)

    # Декоративные искорки вокруг
    for i in range(6):
        phase = (t * 0.7 + i / 6) % 1.0
        a = i * np.pi / 3 + t * 0.9
        r = 6.5 + phase * 2
        alpha_spark = 1.0 - phase
        ax.scatter([r * np.cos(a)], [r * np.sin(a) * 0.6 - 1],
                   s=60, color="#ffd700", marker="*",
                   alpha=alpha_spark * 0.8, zorder=3)

    # Заголовок
    ax.text(0, 6.6, "вся в меня ))", ha="center",
            fontsize=26, color="#c9184a", fontweight="bold",
            family="Comic Sans MS")
    ax.text(0, 5.4, "(кот подтверждает: это комплимент)",
            ha="center", fontsize=11, color="#666", style="italic")

    plt.tight_layout()
    return _pixmap_from_fig(fig)